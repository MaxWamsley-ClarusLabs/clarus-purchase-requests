{
  "name": "clarus-purchase-requests",
  "version": "1.0.0",
  "private": true,
  "description": "Clarus Purchase Requests app: a SharePoint Framework web part, with a local preview on sample data.",
  "engines": {
    "node": ">=22.14.0 < 23.0.0"
  },
  "scripts": {
    "build": "heft test --clean --production && heft package-solution --production",
    "clean": "heft clean",
    "start": "heft start --clean",
    "preview": "vite --config preview/vite.config.mts",
    "preview:build": "vite build --config preview/vite.config.mts",
    "test": "vitest run",
    "sop": "UPDATE_SOP=1 vitest run preview/checks/sop.test.ts",
    "flow-example": "UPDATE_FLOW_EXAMPLE=1 vitest run preview/checks/flow.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p preview/tsconfig.json",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"preview/**/*.{ts,tsx,mts,mjs}\" \"*.{mts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"preview/**/*.{ts,tsx,mts,mjs}\" \"*.{mts,js}\"",
    "screenshots": "node preview/tools/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@microsoft/sp-component-base": "1.23.2",
    "@microsoft/sp-core-library": "1.23.2",
    "@microsoft/sp-http": "1.23.2",
    "@microsoft/sp-webpart-base": "1.23.2",
    "@tesseract.js-data/eng": "1.0.0",
    "pdfjs-dist": "4.10.38",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "tesseract.js": "6.0.1",
    "tslib": "2.3.1",
    "wasm-feature-detect": "1.9.0"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.23.2",
    "@microsoft/eslint-plugin-spfx": "1.23.2",
    "@microsoft/sp-module-interfaces": "1.23.2",
    "@microsoft/spfx-heft-plugins": "1.23.2",
    "@microsoft/spfx-web-build-rig": "1.23.2",
    "@rushstack/heft": "1.2.17",
    "@types/jest": "30.0.0",
    "@types/node": "~22.20.0",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "@types/webpack-env": "~1.15.2",
    "@vitejs/plugin-react": "4.7.0",
    "css-loader": "~7.1.2",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "playwright-core": "1.56.1",
    "prettier": "3.6.2",
    "typescript": "~5.8.0",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "@rushstack/heft": "1.2.17"
  }
}
